@model LoanMVC.Models.CustomerViewModel

@{
    ViewData["Title"] = "Customer Details";
}

<h2>Customer Profile</h2>
@if (ViewBag.MissingFields != null &&
    ((List<string>)ViewBag.MissingFields).Any())
{
    <div class="alert alert-warning">
        <strong>⚠ Profile Incomplete</strong>

        <p>
            Please complete the following details before applying for a loan:
        </p>

        <ul>
            @foreach (var field in (List<string>)ViewBag.MissingFields)
            {
                <li>@field</li>
            }
        </ul>

        <a asp-action="Edit" class="btn btn-primary">
            Complete Profile
        </a>
    </div>
}

<table class="table table-bordered">
    <tr>
        <th>Full Name</th>
        <td>@Model.FullName</td>
    </tr>

    <tr>
        <th>Date of Birth</th>
        <td>@Model.DateOfBirth</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>

    <tr>
        <th>Phone</th>
        <td>@Model.Phone</td>
    </tr>

    <tr>
        <th>Salary</th>
        <td>@Model.Salary</td>
    </tr>

    <tr>
        <th>Employment Type</th>
        <td>@Model.EmploymentType</td>
    </tr>

    <tr>
        <th>Company Name</th>
        <td>@Model.CompanyName</td>
    </tr>

    <tr>
        <th>PAN Number</th>
        <td>@Model.PANNumber</td>
    </tr>

    <tr>
        <th>Aadhaar Number</th>
        <td>@Model.AadhaarNumber</td>
    </tr>

    <tr>
        <th>Guardian Name</th>
        <td>@Model.GuardianName</td>
    </tr>

    <tr>
        <th>Address</th>
        <td>@Model.Address</td>
    </tr>

    <tr>
        <th>Bank Name</th>
        <td>@Model.BankName</td>
    </tr>

    <tr>
        <th>Account Number</th>
        <td>@Model.AccountNumber</td>
    </tr>

    <tr>
        <th>IFSC Code</th>
        <td>@Model.IFSCCode</td>
    </tr>

    <tr>
        <th>Created Date</th>
        <td>@Model.CreatedDate</td>
    </tr>
</table>

<a asp-action="Edit" class="btn btn-primary">Edit Profile</a>