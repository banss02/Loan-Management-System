@model LoanMVC.Models.UpdateCustomerViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<h2>Edit Profile</h2>

<form asp-action="Edit" method="post">

    <input asp-for="CustomerId" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="FullName"></label>
        <input asp-for="FullName" class="form-control"/>
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control"/>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Phone"></label>
        <input asp-for="Phone" class="form-control"/>
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Salary"></label>
        <input asp-for="Salary" class="form-control"/>
        <span asp-validation-for="Salary" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EmploymentType"></label>
        <select asp-for="EmploymentType" class="form-select">
            <option value="Salaried">Salaried</option>
            <option value="Self-Employed">Self-Employed</option>
            <option value="Business">Business</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="CompanyName"></label>
        <input asp-for="CompanyName" class="form-control"/>
    </div>

    <div class="mb-3">
        <label asp-for="PANNumber"></label>
        <input asp-for="PANNumber" class="form-control"/>
    </div>

    <div class="mb-3">
        <label asp-for="AadhaarNumber"></label>
        <input asp-for="AadhaarNumber" class="form-control"/>
    </div>

    <div class="mb-3">
        <label asp-for="GuardianName"></label>
        <input asp-for="GuardianName" class="form-control"/>
    </div>

    <div class="mb-3">
        <label asp-for="Address"></label>
        <textarea asp-for="Address" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="BankName"></label>
        <input asp-for="BankName" class="form-control"/>
    </div>

    <div class="mb-3">
        <label asp-for="AccountNumber"></label>
        <input asp-for="AccountNumber" class="form-control"/>
    </div>

    <div class="mb-3">
        <label asp-for="IFSCCode"></label>
        <input asp-for="IFSCCode" class="form-control"/>
    </div>


    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Details" class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts{
    <partial name="_ValidationScriptsPartial"/>
}