@model List<LoanMVC.Models.DocumentViewModel>

@{
    ViewData["Title"] = "Documents";
    var role = Context.Session.GetString("Role");
}

<h2>@(role == "Admin" ? "All Documents" : "My Documents")</h2>

@if (role != "Admin")
{
    <a asp-action="Upload" class="btn btn-success mb-3">Upload Document</a>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Document Id</th>
            <th>Customer Id</th>
            <th>Name</th>
            <th>Uploaded Date</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.DocumentId</td>
                    <td>@d.CustomerId</td>
                    <td>@d.DocumentName</td>
                    <td>@d.UploadedDate.ToShortDateString()</td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="4">No documents found.</td></tr>
        }
    </tbody>
</table>



