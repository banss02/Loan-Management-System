@model LoanMVC.Models.PaymentViewModel

@{
    ViewData["Title"] = "Make Payment";
}

<h2>Make Payment for Loan #@Model.LoanId</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="LoanId" />
    <input type="hidden" asp-for="ScheduleId" />

    <div class="mb-3">
        <label asp-for="Amount" class="form-label"></label>
        <input asp-for="Amount" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Pay</button>
    <a asp-controller="Loan" asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}