<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - LoanMVC</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">LoanMVC</a>
            <div class="navbar-nav">
                @if (Context.Session.GetString("Token") != null)
                {
                    <a class="nav-link" asp-controller="Loan" asp-action="Index">Loans</a>
                    <a class="nav-link" asp-controller="Payment" asp-action="Index">Payments</a>
                    <a class="nav-link" asp-controller="Document" asp-action="Index">Documents</a>

                    @if (Context.Session.GetString("Role") == "Admin")
                    {
                        <a class="nav-link" asp-controller="Customer" asp-action="Index">Customers</a>
                    }
                    else
                    {
                        <a class="nav-link" asp-controller="Customer" asp-action="Details">My Profile</a>
                    }

                    <span class="nav-link text-muted">Hi, @Context.Session.GetString("Username")</span>
                    <a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a>
                }
                else
                {
                    <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="nav-link" asp-controller="Customer" asp-action="Register">Register</a>
                }
            </div>
        </div>
    </nav>

    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>